# URL pública do convite do Discord (ex.: https://discord.gg/SEU-CODIGO).
# NUNCA coloque token de bot aqui — variáveis VITE_* ficam visíveis no navegador.
VITE_DISCORD_INVITE_URL=

# Reservado para o Arena AI: base da API de encomendas (deixe vazio por enquanto).
VITE_ORDERS_API_URL=

# Login com Discord (Arena AI). Deixe "false" até o backend OAuth2 estar no ar.
# Com "false", o site mostra que o login está em desenvolvimento e não chama a API.
VITE_AUTH_ENABLED=false

# Base da API de autenticação. Vazio = mesma origem (recomendado: /api no mesmo domínio da Vercel).
# NUNCA coloque o Client Secret do Discord aqui — ele fica somente no backend.
VITE_API_BASE_URL=
